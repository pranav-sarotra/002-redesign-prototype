+  text-transform: uppercase;
+}
+
+.copy em {
+  margin-top: 2px;
+  color: var(--accent);
+  font-size: 0.58rem;
+  font-style: normal;
+  font-weight: 800;
+  letter-spacing: 0.14em;
+  line-height: 1.25;
+  text-transform: uppercase;
+}
+
+.compact {
+  gap: 9px;
+}
+
+.compact .crest {
+  width: 36px;
+  height: 36px;
+  padding: 4px;
+  border-radius: 11px;
+}
+
+.compact .copy {
+  gap: 2px;
+}
+
+.compact .copy strong {
+  font-size: 1.05rem;
+}
+
+.compact .copy small {
+  font-size: 0.56rem;
+  letter-spacing: 0.08em;
+}
+
+@media (max-width: 350px) {
+  .compact .copy small {
+    display: none;
+  }
+}
